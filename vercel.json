{
  "version": 2,
  "buildCommand": "mkdir -p public && printf '%s' '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>MathVision API</title></head><body><h1>MathVision API</h1><p>Backend is deployed. Test /api/health and /api/status.</p></body></html>' > public/index.html",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    }
  ]
}
